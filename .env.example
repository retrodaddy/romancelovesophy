# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, NEVER expose

# ── YouTube Data API v3 ────────────────────────────────────
YOUTUBE_API_KEY=your-youtube-api-key              # server only
# Either set the resolved UC… channel id, or leave blank and store it in admin settings
YOUTUBE_CHANNEL_ID=
# Fallback handle used to resolve the channel id automatically
NEXT_PUBLIC_YOUTUBE_HANDLE=@Romancelovesophy

# ── Spotify (podcast) ──────────────────────────────────────
SPOTIFY_SHOW_ID=49dcwx5qz045JY5jRrxxcF
# Optional: enables auto-fetching the LATEST episode. Without these,
# the site embeds the show player (still plays in-page, lists newest first).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Email (contact form) — Resend (free tier) ─────────────
# SIMPLE PATH (no domain email setup needed): visitor messages email Aswin's
# Gmail with Reply-To = the visitor, so he replies in Gmail and the thread
# continues there naturally.
RESEND_API_KEY=
CONTACT_FROM=Romancelovesophy <onboarding@resend.dev>
CONTACT_OWNER_EMAIL=romancelovesophy@gmail.com
# OPTIONAL later (branded from-address + full thread inside admin): verify
# romancelovesophy.com in Resend, then set:
# CONTACT_FROM=Aswin · Romancelovesophy <hello@romancelovesophy.com>
# CONTACT_REPLY_DOMAIN=romancelovesophy.com

# ── Site ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://romancelovesophy.com
